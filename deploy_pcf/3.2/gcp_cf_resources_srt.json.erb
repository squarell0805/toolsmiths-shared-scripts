      "tcp:<%= ssh_router %>"
    ]
  },
  "compute": {
    "instances": 1,
    "internet_connected": false,
    "instance_type": {
      "id": "e2-highmem-2.disk"
    }
  },
  "blobstore": {
    "instances": 1,
    "internet_connected": false,
    "instance_type": {
      "id": "e2-medium.disk"
    }
  },
  "database" : {
    "internet_connected": false
  }
